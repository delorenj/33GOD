# Aperture G1 — environment overrides.
# Copy to .env (gitignored by convention) and adjust per deployment.
# Every variable has a working default; an empty .env runs the bundle.

# --- Images -------------------------------------------------------------------
# Pin/swap images without editing compose.yml. Defaults match the validated
# crib sources (bloodbank/compose + 33god-platform/compose.yaml).
GOD_NATS_IMAGE=nats:2.10-alpine
GOD_NATS_BOX_IMAGE=natsio/nats-box:0.14.5
GOD_DAPR_PLACEMENT_IMAGE=daprio/dapr:1.13.0
GOD_DAPRD_IMAGE=daprio/daprd:1.13.0
GOD_POSTGRES_IMAGE=pgvector/pgvector:pg16
GOD_CANDYSTORE_IMAGE=candystore:g1
GOD_CANDYSTORE_CONTEXT=../../../../candystore
GOD_APICURIO_IMAGE=apicurio/apicurio-registry:3.0.6
GOD_EVENTCATALOG_IMAGE=quay.io/eventcatalog/eventcatalog:2.11.1

# --- Candystore Postgres -------------------------------------------------------
# Change these to deploy the bundle beside another candystore instance; they flow
# into POSTGRES_*, DATABASE_URL, and the pg_isready healthcheck.
GOD_POSTGRES_USER=candystore
GOD_POSTGRES_PASSWORD=candystore
GOD_POSTGRES_DB=candystore

# --- NATS -----------------------------------------------------------------------
# URL the one-shot nats-init container uses to reach the broker (service alias
# on g1-bus). Only override if you change the nats service alias.
GOD_NATS_URL=nats://nats:4222

# Path to the JetStream stream/subject topology nats-init applies. The default
# ships the verbatim bloodbank topology (BLOODBANK_EVENTS / BLOODBANK_COMMANDS /
# GIB_EVENTS). Point it at your own streams.json to ship a different subject
# namespace — the candystore subscription (bloodbank.evt.>) would need to match.
GOD_NATS_STREAMS_JSON=./nats/streams.json
GOD_NATS_INIT_SH=./nats/init.sh
