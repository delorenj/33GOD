# Aperture G4 — environment overrides.
# Copy to .env (gitignored by convention) and adjust per deployment.
# Every variable has a working default; an empty .env runs the bundle.

# --- Images (pinned; every external image is arm64+amd64 manifest-verified) ---
GOD_PROMETHEUS_IMAGE=prom/prometheus:v2.53.1
GOD_GRAFANA_IMAGE=grafana/grafana:11.1.4
GOD_ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
GOD_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
GOD_CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.1
GOD_LOKI_IMAGE=grafana/loki:3.1.1
GOD_ALLOY_IMAGE=grafana/alloy:v1.3.1
GOD_OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.105.0
GOD_PYTHON_IMAGE=python:3.12-alpine
GOD_CURL_IMAGE=curlimages/curl:8.12.1

# --- Grafana ---
# Demo-only defaults; set real values before any real use.
GOD_GRAFANA_USER=admin
GOD_GRAFANA_PASSWORD=aperture-g4-demo-only

# --- alert-bridge -> ntfy -----------------------------------------------------
# Standalone default: EMPTY URL. The bridge formats each alert and logs it
# visibly but does not deliver anywhere (it must never be a single point of
# failure). To page a phone, run the attach overlay (compose.attach.yml) with
# G3's ntfy reachable on the shared network, which flips the default below.
GOD_NTFY_URL=
GOD_NTFY_TOPIC=aperture-g4-alerts

# --- Attached mode (see compose.attach.yml and README.md) ---------------------
# External network name carrying G3's ntfy (G3 names its bridge `g3-internal`).
GOD_G3_NETWORK=g3-internal
