# Defaults are synthetic/demo-only. Copy to .env (ignored); use your own values.
# No credential export, owner account or real Plane webhook is supplied.
GOD_N8N_IMAGE=n8nio/n8n:1.120.4
GOD_POSTGRES_IMAGE=postgres:16-alpine
GOD_NATS_IMAGE=nats:2.10-alpine
GOD_PYTHON_IMAGE=python:3.12-alpine
GOD_CURL_IMAGE=curlimages/curl:8.12.1
GOD_POSTGRES_USER=n8n
GOD_POSTGRES_DB=n8n
GOD_POSTGRES_PASSWORD=g2-demo-postgres-only
GOD_N8N_ENCRYPTION_KEY=g2-demo-only-replace-before-real-use
GOD_DEMO_HEADER_TOKEN=aperture-g2-demo-only
GOD_N8N_HOST=n8n
GOD_WEBHOOK_URL=http://n8n:5678/
GOD_TIMEZONE=UTC
