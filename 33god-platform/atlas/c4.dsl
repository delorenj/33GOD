    c_ntfy_router -> c_ntfy "calls" "ntfy HTTP publish"
    c_ntfy_router -> c_onepassword "calls" "op run --env-file .env.op (render-env.sh)"
    c_op_token_guard -> c_onepassword "reads" "op-token-sync"
    c_op_token_guard -> c_ntfy "calls" "ntfy-alert on ExecStopPost when sync fails"
    c_pilot -> c_plane "calls" "REST https://plane.delo.sh"
    c_pilot -> c_onepassword "calls" "op read of op:// key refs"
    c_pilot -> c_pjangler "calls" "pj list --json (PILOT_PJ)"
    c_pilot -> c_krebs "calls" "python -m krebs.capability (KREBS_CAPABILITY_PYTHON)"
    c_pilot -> c_krebs "reads" "KREBS_MANIFESTS / ~/.config/krebs/manifests.json ownership registry"
    c_pilot -> c_bb_cli "calls" "spawnSync bb call (stdin envelope)"
    c_pilot -> c_bb_nats "publishes-to" "command bloodbank.cmd.lifecycle.task.invoke (request/reply)"
    c_pipeline_mcp_hub -> c_plane "wraps" "PlaneDomain registers plane_mcp.tools in-process"
    c_pjangler -> c_plane "calls" "GET /api/v1/workspaces/{ws}/projects/{board}/ (X-API-Key)"
    c_pjangler -> c_open_notebook "calls" "HTTP /api/notebooks, /api/config, /api/auth/status"
    c_pjangler -> c_redis "writes" "redis-cli zcrank:tab:<tab> hashes (pj crank)"
    c_pjangler -> c_skillex "wraps" "pj skills passes through to bundled @delorenj/skillex bin"
    c_plane_hook -> c_plane "consumes-from" "Plane webhook"
    c_plane_hook -> c_bb_nats "publishes-to" "bloodbank.evt.repo.task.*"
    c_plane_hook -> c_bb_nats "consumes-from" "plane.ticket.created/transitioned (Ticket Triage trigger)"
    c_plane_hook -> c_bb_nats "publishes-to" "bloodbank.cmd.agent.invocation.start (Triage Ticket node)"
    c_plane_hook -> c_bb_nats "consumes-from" "bloodbank.agent.invocation.started/completed/failed (chip)"
    c_plane_hook -> c_plane "writes" "Plane REST labels/issues (agent:working chip)"
    c_plane_hook -> c_candystore "reads" "GET :8683/events (stale chip sweep)"
    c_plane_hook -> c_plane "reads" "Plane REST list issues (Ingress Reconcile)"
    c_plane_hook -> c_ntfy "calls" "n8n-nodes-ntfy-client ntfySend (triage, unrouted)"
    c_plane_hook -> c_n8n "calls" "GET 127.0.0.1:5678/api/v1/executions/<id>"
    c_plane_hook -> c_n8n_nodes_bb "calls" "node types planeBloodbank/bloodbankFleet/bloodbankTrigger"
    c_pr_crusher -> c_bb_nats "publishes-to" "PRC_BLOODBANK_PUBLISH_COMMAND"
    c_pr_crusher -> c_aai_gateway "routes-llm-via" "named pr-crusher consumer token on AutomaticAI gateway"
    c_pr_crusher -> c_onepassword "reads" "op read of the pr-crusher AutomaticAI token ref"
    c_shortwave -> c_vinyl "calls" "VinylSession to vinyl serve :7733 (mic stream)"
    c_skillex -> c_hermes_fleet "writes" "resyncs strict desks under ~/.hermes/profiles/<name>"
    c_target_watch -> c_bb_nats "publishes-to" "bloodbank.watch.target.detected (matcher) and bloodbank.watch.target.routed (sink)"
    c_target_watch -> c_pilot "calls" "sink files or updates a ticket on the target's board"
    c_target_watch -> c_bb_nats "consumes-from" "durable target-watch-matcher, bloodbank.evt.messaging.> and telephony.>"
    c_target_watch -> c_bb_nats "consumes-from" "durable target-watch-sink, bloodbank.evt.watch.target.detected"
    c_target_watch -> c_ntfy "calls" "POST https://ntfy.delo.sh (loud push, ticket button)"
    c_target_watch -> c_candystore "reads" "GET :8683/events (replay command)"
    c_target_watch -> c_onepassword "calls" "op read of ntfy token ref"
    c_traefik -> c_holocene_web "calls" "route Host(holocene.delo.sh) google-auth"
    c_traefik -> c_agent_pad "calls" "route Host(agent-pad.delo.sh)||Host(agents.delo.sh); /upload/ to :8080"
    c_traefik -> c_flume_access "calls" "route Host(identity-origin.delo.sh) to host :18791"
    c_traefik -> c_genesis "calls" "route Host(genesis.delo.sh) to :8741"
    c_traefik -> c_farm_command_bridge "calls" "route Host(farm-commands.delo.sh), Host(mercury-hooks.delo.sh)"
    c_transcribe -> c_minio "writes" "mc cp to delo/recordings with --archive-s3"
    c_turn_enricher -> c_bb_nats "consumes-from" "bloodbank.evt.conversation.turn.completed"
    c_turn_enricher -> c_bb_nats "publishes-to" "bloodbank.evt.conversation.turn.annotated"
    c_turn_enricher -> c_jev_litellm "calls" "POST https://jev.delo.sh/typesafe/v1/systemone"
    c_turn_enricher -> c_cloudflare "calls" "Workers AI @cf/cloudflare/clairic"
    c_vinyl -> c_aai_gateway "routes-llm-via" "VINYL_CLEANUP_URL api.automaticai.io/v1 chat/completions"
    c_vinyl -> c_aai_gateway "routes-llm-via" "VINYL_TRANSLATE_URL api.automaticai.io/v1 (live translation)"
    c_vinyl -> c_jev_litellm "calls" "POST jev.delo.sh/typesafe/v1/systemone (dictionary judge)"
    c_vinyl -> c_wax "calls" "imports wax.dictionary and wax.jev from components/wax/src"
    c_vox -> c_postgres "stores-in" "VOX_DATABASE_URL host postgres db vox"
    c_wax -> c_bb_nats "publishes-to" "bloodbank.evt.audio.* (task, session, transcription) via raw NATS TCP"
    c_wax -> c_pjangler "calls" "GET project registry service 127.0.0.1:8764"
    c_wax -> c_transcribe "calls" "WAX_TRANSCRIBE / transcribe CLI subprocess"
    c_wax -> c_jev_litellm "calls" "POST jev.delo.sh/typesafe/v1/systemone (classification passes)"
    c_wax -> c_aai_gateway "routes-llm-via" "api.automaticai.io/v1 chat/completions (title, summarize, tickets)"
    c_wax -> c_pilot "calls" "px CLI files failure tickets on HEYMA board (wax failures sweep)"
    c_wingman -> c_bb_nats "publishes-to" "bloodbank.evt.crank.<action> raw NATS PUB"
    c_wingman -> c_bb_nats "consumes-from" "deckard.evt.attention subscription"
    c_wingman -> c_asm "reads" "redis pubsub asm:transitions and asm:live / asm:a:<scope> hashes"
    c_wingman -> c_crank "reads" "redis scan zcrank:tab:*"
    c_wingman -> c_pjangler "reads" "GET 127.0.0.1:8764/v1/registry"
    c_wingman -> c_candystore "reads" "GET 127.0.0.1:8683/events"
    c_wingman -> c_vox "calls" "POST vox.delo.sh /synthesize and /sink/{key}/say"
    c_wingman -> c_transcribe "calls" "POST 127.0.0.1:8766/v1/audio/transcriptions"
    c_wingman -> c_aai_gateway "routes-llm-via" "llm_base_url api.automaticai.io/v1 (pydantic-ai)"
  }
  views {
    systemContext god "context" { include * autoLayout }
    container god "containers" { include * autoLayout lr }
    component c_bloodbank "components-bloodbank" { include * autoLayout }
    component c_candybar "components-candybar" { include * autoLayout }
    component c_flume "components-flume" { include * autoLayout }
    component c_genesis "components-genesis" { include * autoLayout }
    component c_hermes_fleet "components-hermes-fleet" { include * autoLayout }
    component c_heyma "components-heyma" { include * autoLayout }
    component c_holocene "components-holocene" { include * autoLayout }
    component c_hook_hub "components-hook-hub" { include * autoLayout }
    component c_mon_core "components-mon-core" { include * autoLayout }
    styles {
      element "External" { background #8a8f98 }
      element "Person" { shape person }
    }
  }
}
