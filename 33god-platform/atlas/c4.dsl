    c_inbox_watcher -> c_bb_nats "publishes-to" "bb-emit facts bloodbank.audio.memo.<stage>"
    c_inbox_watcher -> c_candystore "reads" "GET CANDYSTORE_URL /events?correlationid=<memo_id>"
