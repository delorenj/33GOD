    c_flume -> c_agents_registry "writes" "~/.hermes/agents-registry.yaml"
    c_flume_access -> c_cloudflare "calls" "Cloudflare Access JWT verification (pinned iss/aud); the agents-facade Worker at identity.delo.sh proxies to this origin"
    c_genesis -> c_aai_gateway "routes-llm-via" "gateway keys in container env"
    c_genesis_desk_worker -> c_genesis "calls" "HTTPS to :8741 via tunnel"
    c_hermes_bloodbank_plugin -> c_bb_nats "consumes-from" "bloodbank.cmd.agent.invocation.start / .invoke"
    c_hermes_fleet -> c_agents_registry "reads" "~/.hermes/agents-registry.yaml"
    c_hermes_gateway_watchdog -> c_hermes_gw "reads" "health probe then systemctl --user restart"
    c_hermes_gw -> c_aai_gateway "routes-llm-via" "OpenAI-compatible provider in config.yaml"
    c_hindsight -> c_aai_gateway "routes-llm-via" "litellm router primary"
