workspace "33GOD" "One map of every component (I-12)" {
  model {
    c_operator = person "Operator" "The solo owner who runs the platform, steers agents and reviews results."
    c_client = person "Client" "Someone who leases a 33GOD agent and talks to it through their Genesis desk."
    c_mirror_operator = person "Mirror-site operator" "A collaborator who runs a mirrored copy of the platform on their own machine."
    c_voice_user = person "Voice user" "Someone dictating or sending voice memos into the platform."
    c_cloudflare = softwareSystem "Cloudflare" "Hosts tunnels, Workers and Workers AI models." { tags "External" }
