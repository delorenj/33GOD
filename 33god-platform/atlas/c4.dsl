    c_inbox_watcher -> c_agents_registry "reads" "MEMO_AGENT_REGISTRY registry_route() yaml"
    c_infra_doctor -> c_n8n "calls" "HTTPS probe n8n.delo.sh/healthz"
    c_infra_doctor -> c_hindsight "calls" "HTTPS probe api.hs.delo.sh/health"
    c_infra_doctor -> c_aai_gateway "calls" "HTTPS probe api.automaticai.io/api/status"
    c_infra_doctor -> c_vox "calls" "HTTPS probe vox.delo.sh"
    c_infra_doctor -> c_ntfy "calls" "HTTPS probe ntfy.delo.sh/v1/health"
    c_infra_doctor -> c_traefik "calls" "HTTPS probe traefik.delo.sh"
    c_infra_doctor -> c_hermes_gw "calls" "hermes-gateway-check liveness|channels|restart"
