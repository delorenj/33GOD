      group "Voice Pipeline" {
        c_heyma = container "HeyMa" "The voice system: dictate, transcribe and hear replies." "python" {
          c_intake = component "Intake" "Takes transcribed voice notes and files them as tasks or notes." "python"
          c_transcribe = component "Transcription" "Turns recorded audio into text, using local Whisper models on a GPU." "whisper"
          c_vinyl = component "Vinyl" "Dictation server that turns speech into text in real time." "python"
          c_vox = component "Vox" "Text-to-speech that reads replies aloud in chosen voices." "tts"
          c_wax = component "Wax (waxd)" "Processes voice recordings through cleanup and titling passes." "python"
        }
      }
      group "Enrichment and Memory" {
        c_aai_gateway = container "AutomaticAI LLM gateway" "One front door that routes every model request to the right provider." "newapi" {
        }
        c_cost_bridge = container "cost-bridge" "Takes in billing cost records over HTTPS, puts them on the bus and replays them into the AutomaticAI portal until each one is confirmed saved." "python" {
        }
        c_enricher = container "Candystore enricher" "Adds search embeddings to stored events so they can be found by meaning." "python, bge-small" {
        }
        c_turn_enricher = container "turn-enricher" "Reads each finished agent turn and tags it with its main action, artifacts and blocker." "python, nats, httpx" {
        }
      }
      group "Orchestration and Apps" {
        c_delonet_director = container "DeLoNET Director read model" "A read-only API over company capacity and contract data." "python" {
        }
        c_flume = container "Flume" "Hires, onboards and reviews agents and keeps the roster." "typescript" {
          c_flume_access = component "Flume access facade" "The front door that lets Cloudflare Access-authenticated employees reach agent identity data." "node, typescript, cloudflare-access"
        }
        c_holocene = container "Holocene" "The operator's web app showing agents, schedules and events in one place." "typescript, react" {
          c_agent_pad = component "Agent pad" "A Holocene screen for talking to and watching individual agents." "typescript"
          c_holocene_api = component "Holocene API" "The backend that gathers fleet, schedule and event data for the web app." "typescript"
          c_holocene_web = component "Holocene web" "The browser front end of Holocene." "react"
          c_inbox_watcher = component "Voice memo inbox watcher" "Watches for new voice memos and sends them to transcription." "typescript, whisper"
        }
        c_krebs = container "Krebs" "Decides which ticket goes to which agent and sends the work order." "node" {
        }
        c_lifecycle_controller = container "lifecycle-controller" "Reconciles ticket lifecycle state from sentinel observations and publishes the results." "python, asyncpg" {
