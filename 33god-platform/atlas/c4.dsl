    c_hook_hub -> c_agent_hooks "calls" "handlers.toml publisher handler"
    c_hook_hub -> c_hindsight "calls" "~/.agents/hooks/hub/concerns.py handlers"
    c_krebs -> c_bb_nats "publishes-to" "bloodbank.cmd.agent.invocation.start"
    c_krebs -> c_plane "reads" "Plane REST"
    c_milkshake -> c_bb_nats "consumes-from" "farm-command-bridge and cost-bridge events"
    c_milkshake -> c_bb_nats "consumes-from" "bloodbank.cmd.billing.invoice.generate (milkshake-farm-consumer)"
