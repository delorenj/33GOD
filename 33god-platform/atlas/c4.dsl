    c_daily_report -> c_candybar "reads" "GET :8700/candybars (fleet_health collector)"
    c_daily_report -> c_open_notebook "writes" "POST /api/notes in notebook 'Dev Journal'"
    c_daily_report -> c_bb_nats "publishes-to" "Dapr :3504 bloodbank-pubsub, bloodbank.evt.reporting.report.*"
