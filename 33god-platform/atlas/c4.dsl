        c_deckard = container "Deckard" "A Stream Deck control surface for the operator's terminal workspace." "" {
        }
        c_shortwave = container "Shortwave relay" "Mirrors phone dictation into the focused terminal pane." "python, zellij" {
        }
        c_wingman = container "Wingman" "Voice relay that types the operator's dictated words into agent sessions." "" {
