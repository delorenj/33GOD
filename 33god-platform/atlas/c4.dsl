          c_candybar_steward = component "Candybar steward" "Host-side role that keeps Candybar's registrations and units in order." "python, systemd"
          c_candybar_watchdog = component "Candybar watchdog timer" "A tiny timer that pages if Candybar itself stops." "systemd"
        }
      }
