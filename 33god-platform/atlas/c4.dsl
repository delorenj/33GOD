    c_hindsight = softwareSystem "Hindsight" "Long-term memory where agents store and recall project facts." { tags "External" }
    c_jev_litellm = softwareSystem "Jev LiteLLM" "A typed-question model service used for yes/no style judgments." { tags "External" }
    c_minio = softwareSystem "MinIO" "Object storage for files." { tags "External" }
    c_n8n = softwareSystem "n8n workflow engine" "Runs webhook workflows that convert ticket and journal events into bus events." { tags "External" }
    c_ntfy = softwareSystem "ntfy" "A push-notification server that delivers alerts to phones." { tags "External" }
    c_onepassword = softwareSystem "1Password" "Vault holding every credential as op:// references." { tags "External" }
    c_open_notebook = softwareSystem "Open Notebook" "The notebook site where the owner wants generated docs placed." { tags "External" }
    c_openrouter = softwareSystem "OpenRouter" "A paid model marketplace used as a fallback provider." { tags "External" }
    c_plane = softwareSystem "Plane" "The ticket board where work is tracked in lanes." { tags "External" }
    c_postgres = softwareSystem "PostgreSQL" "Database engine behind Candystore, Candybar, pjangler, n8n and Plane." { tags "External" }
    c_redis = softwareSystem "Redis" "In-memory store for live agent state and the 1Password read cache." { tags "External" }
    c_traefik = softwareSystem "Traefik" "Reverse proxy that routes *.delo.sh hostnames to services." { tags "External" }
    god = softwareSystem "33GOD" "Event-driven agentic development platform composed from independently versioned repos and coordinated by this control plane." {
      group "Bloodbank Core Bus" {
        c_bloodbank = container "Bloodbank" "The event backbone: every service publishes and listens for CloudEvents on it." "nats-jetstream, cloudevents, dapr" {
          c_bb_apicurio = component "Apicurio schema registry" "A schema registry meant for looking up event schemas at runtime." "apicurio"
          c_bb_catalog = component "EventCatalog" "A browsable website listing every event type for humans." "eventcatalog"
          c_bb_cli = component "bb operator CLI" "Command-line tool to check the contract, emit, trace and replay bus events." "python"
          c_bb_dapr = component "Dapr sidecars" "Dapr sidecars that deliver bus events to Candystore and the enricher." "dapr:1.13"
          c_bb_nats = component "Bloodbank NATS broker" "The NATS JetStream server that stores and delivers bus messages." "nats:2.10, jetstream"
          c_event_contract = component "Bloodbank event contract and schemas" "The rulebook and 214 JSON schemas that say how every event is named and shaped." "json-schema-2020-12, cloudevents"
        }
        c_candystore = container "Candystore" "Saves a permanent copy of every bus event so history can be searched later." "python, postgres, pgvector" {
        }
        c_heartbeat_tick = container "heartbeat-tick and recorder" "A sample producer/consumer pair that emits and records system heartbeat events." "python, dapr" {
        }
      }
      group "Integration Plane" {
        c_curator = container "Curator" "Sorts and files incoming documents and folders automatically." "python" {
        }
        c_n8n_devjournal = container "Dev journal workflow" "An n8n workflow that writes development journal entries from events." "n8n" {
        }
        c_n8n_nodes_bb = container "n8n-nodes-bloodbank" "A custom n8n node that publishes contract-valid events onto Bloodbank." "typescript, n8n" {
        }
        c_pdf2md = container "pdf2md" "Converts PDFs to Markdown for n8n workflows." "python" {
        }
        c_plane_hook = container "Plane to Bloodbank workflows" "n8n workflows (Plane->Bloodbank, Ticket Triage, Pickup Chip, Lane Errors, Ingress Reconcile) that react to ticket changes." "n8n" {
        }
      }
      group "Agent Fleet Runtime" {
        c_artifact_sidecar = container "artifact-sidecar" "Captures files agents produce and links them to the events that made them." "python" {
        }
        c_artifact_vault_projector = container "artifact-vault-projector" "Writes captured agent artifacts into the operator's notes vault, organized by project and date." "python" {
        }
        c_hermes_fleet = container "Hermes Fleet" "The set of AI agents (project managers, directors, specialists) that do the platform's work." "python, hermes-agent" {
          c_agents_registry = component "Agents registry" "A file listing every agent, its role and where it works." "yaml"
          c_hermes_bloodbank_plugin = component "Hermes Bloodbank platform plugin" "Lets the gateway receive work orders from the bus and start agent turns." "python, nats"
          c_hermes_dashboard = component "Hermes Dashboard" "A web dashboard for the whole Hermes agent runtime." "python, hermes-agent"
          c_hermes_gateway_watchdog = component "hermes-gateway-watchdog" "Restarts the Hermes gateway if it is down or wedged and sends a phone alert." "systemd, shell"
          c_hermes_gw = component "Hermes gateway" "The one long-running process that hosts every agent profile and their chat bots." "python"
        }
        c_hook_hub = container "hook-hub" "Receives every agent hook and fans it out to handlers that publish, remember and alert." "python" {
          c_agent_hooks = component "agent-hooks publisher" "Turns raw agent hooks into contract-valid events and publishes them." "python"
          c_asm = component "Agent State Machine" "Keeps a live picture of what each agent process is doing right now." "python, redis"
          c_bb_hook = component "bb-hook" "A tiny command each coding agent runs on every hook to hand the event to hook-hub." "shell"
        }
        c_ntfy_router = container "ntfy-router" "Sends phone notifications for important bus events." "python, nats" {
        }
        c_target_watch = container "target-watch" "Alerts the operator whenever a watched person messages on any channel and files a ticket for it." "python" {
        }
      }
      group "Observability" {
        c_daily_report = container "DeLoNET daily report" "A once-a-day summary of what happened across the platform." "python" {
        }
        c_infra_doctor = container "infra-doctor" "Runs synthetic probes against the homelab and platform and flags what is broken." "systemd, shell" {
        }
        c_mon_core = container "Monitoring core" "Dashboards and metric storage for the platform." "prometheus, grafana" {
          c_aai_llm_observability = component "AAI LLM observability" "Collects and reshapes gateway usage logs into metrics." "python"
          c_jev_clairic_exporter = component "Jev/Clairic usage exporter" "Publishes Jev and Clairic usage as Prometheus metrics." "python, prometheus"
          c_mon_alerts = component "Monitoring alerts" "Rules that fire when something looks unhealthy." "alertmanager"
          c_mon_exporters = component "Monitoring exporters" "Small collectors that expose host and service metrics." "prometheus-exporters"
        }
      }
      group "Project Tooling" {
        c_commonproject = container "CommonProject" "Shared scaffolding every project starts from." "" {
        }
        c_pipeline_mcp_hub = container "Pipeline MCP Hub" "One place that exposes platform tools to agents over MCP." "mcp" {
        }
        c_pjangler = container "PJangler" "Keeps the list of projects and their metadata consistent." "typescript" {
        }
        c_pr_crusher = container "PR Crusher" "Works through open pull requests automatically and reports progress." "typescript" {
        }
        c_skillex = container "Skillex" "The shared catalog of agent skills and the tool that installs them on each agent's desk." "markdown, shell" {
        }
