    c_mon_core -> c_mon_alerts "calls" "prometheus alerting.alertmanagers alertmanager:9093"
    c_mon_core -> c_aai_llm_observability "reads" "prometheus scrape aai-llm-observability:9480"
    c_mon_core -> c_jev_clairic_exporter "reads" "prometheus scrape host.docker.internal:9491"
    c_mon_core -> c_candybar "reads" "prometheus scrape candybar:8700"
    c_mon_core -> c_candybar_executor "reads" "prometheus scrape host.docker.internal:8701"
    c_mon_core -> c_mon_exporters "reads" "prometheus scrape nats-exporter:7777"
    c_mon_core -> c_mon_exporters "reads" "prometheus scrape node-exporter:9100, cadvisor:8080"
    c_mon_exporters -> c_bb_nats "reads" "nats-exporter -varz -jsz=all http://bloodbank-nats:8222"
    c_n8n -> c_bb_nats "publishes-to" "n8n-nodes-bloodbank node, repo.task.* events"
    c_n8n_devjournal -> c_bb_nats "consumes-from" "bloodbank.reporting.report.completed (durable trigger)"
    c_n8n_devjournal -> c_bb_nats "publishes-to" "bloodbank.reporting.journal.received"
    c_n8n_devjournal -> c_bb_nats "publishes-to" "bloodbank.reporting.incident.observed"
    c_n8n_devjournal -> c_aai_gateway "routes-llm-via" "POST api.automaticai.io/v1/chat/completions"
    c_n8n_devjournal -> c_n8n_nodes_bb "calls" "node types bloodbankTrigger/devJournal/bloodbank"
    c_n8n_nodes_bb -> c_bb_nats "consumes-from" "BloodbankTrigger durable consumer on BLOODBANK_EVENTS"
    c_n8n_nodes_bb -> c_pjangler "reads" "GET :8764/v1/registry (Plane board routes)"
    c_n8n_nodes_bb -> c_agents_registry "reads" "~/.hermes/agents-registry.yaml (Fleet node)"
    c_n8n_nodes_bb -> c_plane "calls" "Plane REST via planeReader (reconcile)"
    c_n8n_nodes_bb -> c_event_contract "reads" "codegen reads bloodbank/schemas/** for node events"
