    c_plane_hook -> c_plane "consumes-from" "Plane webhook"
    c_plane_hook -> c_bb_nats "publishes-to" "bloodbank.evt.repo.task.*"
    c_pr_crusher -> c_bb_nats "publishes-to" "PRC_BLOODBANK_PUBLISH_COMMAND"
    c_target_watch -> c_bb_nats "publishes-to" "bloodbank.watch.target.detected (matcher) and bloodbank.watch.target.routed (sink)"
    c_target_watch -> c_pilot "calls" "sink files or updates a ticket on the target's board"
    c_turn_enricher -> c_bb_nats "consumes-from" "bloodbank.evt.conversation.turn.completed"
    c_turn_enricher -> c_bb_nats "publishes-to" "bloodbank.evt.conversation.turn.annotated"
    c_turn_enricher -> c_jev_litellm "calls" "POST https://jev.delo.sh/typesafe/v1/systemone"
    c_turn_enricher -> c_cloudflare "calls" "Workers AI @cf/cloudflare/clairic"
  }
  views {
    systemContext god "context" { include * autoLayout }
    container god "containers" { include * autoLayout lr }
    component c_bloodbank "components-bloodbank" { include * autoLayout }
    component c_candybar "components-candybar" { include * autoLayout }
