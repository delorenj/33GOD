    c_hermes_gateway_watchdog -> c_ntfy "calls" "ntfy-alert to ntfy.delo.sh/infra"
    c_hermes_gw -> c_aai_gateway "routes-llm-via" "OpenAI-compatible provider in config.yaml"
    c_hermes_gw -> c_hermes_bloodbank_plugin "hosts" "plugins.enabled bloodbank-platform in config.yaml"
    c_hermes_gw -> c_hermes_fleet "hosts" "agents-registry gateways.bloodbank scope fleet, hermes-gateway.service"
