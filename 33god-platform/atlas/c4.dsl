    c_hermes_gw -> c_vox "calls" "tts.vox.base_url https://vox.delo.sh"
    c_heyma -> c_wax "calls" "bin/heyma and bin/wax launchers exec components/wax/bin/*"
    c_heyma -> c_transcribe "wraps" "hermes-transcribe-adapter shells out to bin/transcribe"
    c_hindsight -> c_aai_gateway "routes-llm-via" "litellm router primary"
