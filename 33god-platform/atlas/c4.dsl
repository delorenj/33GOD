    c_infra_doctor -> c_candybar_watchdog "reads" "file_age ~/.local/state/candybar-watchdog/ok"
    c_infra_doctor -> c_hermes_gateway_watchdog "reads" "file_age ~/.local/state/hermes-gateway-watchdog/last-run"
    c_intake -> c_minio "reads" "aws s3 s3.delo.sh bucket recordings (Telnyx native recordings)"
    c_intake -> c_wax "writes" "delivers mp3 files into HeyMa inbox/ directory"
    c_jev_clairic_exporter -> c_candystore "reads" "GET :8683/events?type=bloodbank.conversation.turn.annotated"
    c_jev_clairic_exporter -> c_openrouter "calls" "GET openrouter.ai/api/v1/keys/<id> (JEV_API_MGMT_KEY)"
    c_jev_clairic_exporter -> c_onepassword "calls" "op run --env-file jev-clairic-exporter.env.op"
    c_krebs -> c_bb_nats "publishes-to" "bloodbank.cmd.agent.invocation.start"
    c_krebs -> c_plane "reads" "Plane REST"
    c_krebs -> c_agents_registry "reads" "loadHermesRegistry(~/.hermes/agents-registry.yaml)"
    c_krebs -> c_pilot "calls" "import pilot/src/plane.js Plane + config.js homeBinding"
    c_krebs -> c_n8n_nodes_bb "calls" "require dist/nats.js publish, buildEnvelope; dist/registry.js"
    c_krebs -> c_bb_nats "consumes-from" "durable krebs-execution-v2 on bloodbank.cmd.lifecycle.task.invoke"
    c_krebs -> c_bb_nats "publishes-to" "outbox bloodbank.{evt,rpy,cmd}.lifecycle.<entity>.<action>"
    c_krebs -> c_postgres "stores-in" "KREBS_DATABASE_URL schema krebs (store, outbox)"
    c_krebs -> c_pilot "calls" "node provider-helper.js (KREBS_PILOT_HELPER) apply/read ops"
    c_lifecycle_controller -> c_krebs "wraps" "importlib krebs.project_health.main/reconciler/worker/sweeper"
    c_lifecycle_controller -> c_postgres "stores-in" "DATABASE_URL tables lifecycle_event_outbox etc, shared with candystore pg"
    c_milkshake -> c_bb_nats "consumes-from" "farm-command-bridge and cost-bridge events"
