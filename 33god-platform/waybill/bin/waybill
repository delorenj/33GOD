#!/usr/bin/env bash
# waybill launcher: a flight recorder for one prompt across 33GOD (see ../SPEC.md).
# Stdlib-only Python; `record` also needs nats-py, which may live in a different interpreter
# than /usr/bin/python3, so for `record` pick the first python3 that can import it.
set -euo pipefail
ROOT="/home/delorenj/code/33GOD/33god-platform/waybill"
PY="${WAYBILL_PYTHON:-/usr/bin/python3}"
if [ -z "${WAYBILL_PYTHON:-}" ] && [ "${1:-}" = "record" ] && ! "$PY" -c 'import nats' 2>/dev/null; then
  for c in "$(command -v python3 2>/dev/null || true)" "$HOME"/.local/share/mise/installs/python/3.1*/bin/python3; do
    if [ -n "$c" ] && [ -x "$c" ] && "$c" -c 'import nats' 2>/dev/null; then PY="$c"; break; fi
  done
fi
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
# -P: never put the cwd on sys.path (a stray inspect.py / json.py in the cwd would shadow the stdlib)
exec "$PY" -P -m waybill "$@"
