{
  "schema_version": 1,
  "component": "krebs",
  "version": "2.0.0",
  "artifact_type": "python-package",
  "runtime_mode": "host-service",
  "source": "https://github.com/delorenj/33GOD",
  "build": "uv sync --frozen --no-dev && uv build",
  "validation": "mise run test",
  "readiness": "uv run krebs readiness",
  "migration": "uv run krebs migrate",
  "activation": "blocked-until-enrolled-and-pinned",
  "required_pins": [
    "source_revision",
    "wheel_sha256",
    "requirements_sha256",
    "pilot_bundle_sha256",
    "momo_bundle_sha256"
  ],
  "installer": "python3 ops/install.py release.json --destination RELEASE_DIRECTORY"
}
