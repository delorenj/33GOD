#!/usr/bin/env bash
# 33GOD repo pre-commit dispatcher (versioned; installed by .githooks/install.sh,
# which `mise` runs on directory enter).
#
# The fleet-wide guard (~/.config/git/hooks/pre-commit) runs first and chains
# to .git/hooks/pre-commit, a symlink to this file. Each gate below is cheap
# and only fires when its paths are staged.
#
#   1. APERTURE CHARTER GATE  - aperture/ edits need a fresh charter marker
#   2. ATLAS GATE (I-12)      - registry edits re-render the Atlas into the same
#                               commit, then the schema + scrub check must pass
set -u
ROOT="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACMRD)"

# 1. APERTURE CHARTER GATE
bash "$ROOT/33god-platform/aperture/scripts/charter-pre-commit.sh" "$@" || exit 1

# 2. ATLAS GATE: the rendered views can never lag the registry they came from.
if printf '%s\n' "$staged" | grep -qE '^33god-platform/(components/|components\.yaml$|atlas/|scripts/atlas\.py$)'; then
  ATLAS="$ROOT/33god-platform/scripts/atlas.py"
  if ! python3 "$ATLAS" render >/dev/null; then
    echo "ATLAS GATE: render failed; fix the registry (python3 33god-platform/scripts/atlas.py check)" >&2
    exit 1
  fi
  git -C "$ROOT" add 33god-platform/atlas
  if ! python3 "$ATLAS" check >&2; then
    echo "ATLAS GATE: registry is invalid or a public field leaks internal detail (see above)" >&2
    exit 1
  fi
fi
exit 0
